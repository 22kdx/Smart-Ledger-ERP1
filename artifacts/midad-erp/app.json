{
  "expo": {
    "name": "TAMM ERP",
    "slug": "midad-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#F4F6FA"
    },
    "icon": "./assets/images/tamm-app-icon.png",
    "scheme": "midad-erp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "supportsRTL": true
    },
    "web": {
      "favicon": "./assets/images/tamm-app-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
